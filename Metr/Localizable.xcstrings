{
  "sourceLanguage": "en",
  "strings": {
    "CPU": {
      "comment": "Panel column title and tooltip label for processor load",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU"
          }
        }
      }
    },
    "Memory": {
      "comment": "Panel column title for memory",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Memoria"
          }
        }
      }
    },
    "Disk": {
      "comment": "Panel column title for the startup disk",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Disco"
          }
        }
      }
    },
    "Normal": {
      "comment": "Memory pressure word shown as the panel value",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Normal"
          }
        }
      }
    },
    "Elevated": {
      "comment": "Memory pressure word shown as the panel value (kernel warn level)",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elevada"
          }
        }
      }
    },
    "Critical": {
      "comment": "Memory pressure word shown as the panel value",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crítica"
          }
        }
      }
    },
    "%@ of %@": {
      "comment": "Memory detail line: used amount of total amount, e.g. 11.2 of 16 GB",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de %@"
          }
        }
      }
    },
    "free": {
      "comment": "Disk detail line under the free-space amount, e.g. 210 GB free",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "libres"
          }
        }
      }
    },
    "Unavailable": {
      "comment": "Detail line when a metric could not be read",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No disponible"
          }
        }
      }
    },
    "About Metr": {
      "comment": "Right-click menu item that opens the standard About panel",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerca de Metr"
          }
        }
      }
    },
    "Quit Metr": {
      "comment": "Panel footer button that quits the app",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salir de Metr"
          }
        }
      }
    },
    "Normal pressure": {
      "comment": "VoiceOver reading for the memory column",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Presión normal"
          }
        }
      }
    },
    "Elevated pressure": {
      "comment": "VoiceOver reading for the memory column",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Presión elevada"
          }
        }
      }
    },
    "Critical pressure": {
      "comment": "VoiceOver reading for the memory column",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Presión crítica"
          }
        }
      }
    },
    "CPU: %@": {
      "comment": "Tooltip line for processor load",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU: %@"
          }
        }
      }
    },
    "Memory: Normal pressure · %@ of %@": {
      "comment": "Tooltip memory line, normal pressure: used of total",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Memoria: presión normal · %1$@ de %2$@"
          }
        }
      }
    },
    "Memory: Elevated pressure · %@ of %@": {
      "comment": "Tooltip memory line, elevated pressure: used of total",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Memoria: presión elevada · %1$@ de %2$@"
          }
        }
      }
    },
    "Memory: Critical pressure · %@ of %@": {
      "comment": "Tooltip memory line, critical pressure: used of total",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Memoria: presión crítica · %1$@ de %2$@"
          }
        }
      }
    },
    " · Swap %@": {
      "comment": "Tooltip suffix appended to the memory line only when swap is in use",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " · Swap %@"
          }
        }
      }
    },
    "Disk: %@ free of %@": {
      "comment": "Tooltip disk line: free amount of total",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Disco: %1$@ libres de %2$@"
          }
        }
      }
    },
    "CPU: unavailable": {
      "comment": "Tooltip line when the CPU read failed",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU: no disponible"
          }
        }
      }
    },
    "Memory: unavailable": {
      "comment": "Tooltip line when the memory read failed",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Memoria: no disponible"
          }
        }
      }
    },
    "Disk: unavailable": {
      "comment": "Tooltip line when the disk read failed",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Disco: no disponible"
          }
        }
      }
    },
    "Metr lives in your menu bar": {
      "comment": "Welcome window headline",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Metr vive en tu barra de menús"
          }
        }
      }
    },
    "Click the rings for details": {
      "comment": "Welcome window instruction under the rings preview",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en los anillos para ver los detalles"
          }
        }
      }
    },
    "Don't see them? Turn Metr on in System Settings › Menu Bar.": {
      "comment": "Welcome window tip about the Menu Bar permission",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿No los ves? Activa Metr en Ajustes del Sistema › Barra de menús."
          }
        }
      }
    },
    "Done": {
      "comment": "Welcome window primary button",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo"
          }
        }
      }
    },
    "Open Menu Bar Settings": {
      "comment": "Welcome window secondary button that opens System Settings",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir ajustes de la Barra de menús"
          }
        }
      }
    },
    "Open System Settings, go to Menu Bar, and turn Metr on.": {
      "comment": "Welcome window tip shown after the Settings deep link could not land on the Menu Bar pane",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Ajustes del Sistema, ve a Barra de menús y activa Metr."
          }
        }
      }
    },
    "User": {
      "comment": "CPU column row label: share of CPU time spent in user processes (PANEL-01)",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuario"
          }
        }
      }
    },
    "System": {
      "comment": "CPU column row label: share of CPU time spent in the kernel and system (PANEL-01)",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistema"
          }
        }
      }
    },
    "User %@, system %@.": {
      "comment": "VoiceOver reading of the CPU column's user and system percentages",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuario %1$@, sistema %2$@."
          }
        }
      }
    },
    "Perf": {
      "comment": "CPU cluster label: abbreviation of the system tier 'Performance' (hw.perflevelN.name)",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rend."
          }
        }
      }
    },
    "Eff": {
      "comment": "CPU cluster label: abbreviation of the system tier 'Efficiency' (hw.perflevelN.name)",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Efic."
          }
        }
      }
    },
    "Super": {
      "comment": "CPU cluster label: the system tier 'Super' (M5 family)",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Super"
          }
        }
      }
    },
    "Performance cores %@": {
      "comment": "VoiceOver: average load of the performance core cluster, e.g. Performance cores 41%",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Núcleos de rendimiento %@"
          }
        }
      }
    },
    "Efficiency cores %@": {
      "comment": "VoiceOver: average load of the efficiency core cluster, e.g. Efficiency cores 18%",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Núcleos de eficiencia %@"
          }
        }
      }
    },
    "Super cores %@": {
      "comment": "VoiceOver: average load of the Super core cluster (M5 family)",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Núcleos Super %@"
          }
        }
      }
    },
    "%@ cores %@": {
      "comment": "VoiceOver: average load of a core cluster with a name this app has no translation for: system name, then percent",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Núcleos %1$@ %2$@"
          }
        }
      }
    }
  },
  "version": "1.0"
}
