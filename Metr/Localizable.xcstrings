{
  "sourceLanguage": "en",
  "strings": {
    "CPU": {
      "comment": "Panel column title and tooltip label for processor load",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU"
          }
        }
      }
    },
    "Memory": {
      "comment": "Panel column title for memory",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Memoria"
          }
        }
      }
    },
    "Disk": {
      "comment": "Panel column title for the startup disk",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Disco"
          }
        }
      }
    },
    "Normal": {
      "comment": "Memory pressure word shown as the panel value",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Normal"
          }
        }
      }
    },
    "Elevated": {
      "comment": "Memory pressure word shown as the panel value (kernel warn level)",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elevada"
          }
        }
      }
    },
    "Critical": {
      "comment": "Memory pressure word shown as the panel value",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crítica"
          }
        }
      }
    },
    "%@ of %@": {
      "comment": "Memory detail line: used amount of total amount, e.g. 11.2 of 16 GB",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de %@"
          }
        }
      }
    },
    "free": {
      "comment": "Disk detail line under the free-space amount, e.g. 210 GB free",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "libres"
          }
        }
      }
    },
    "Unavailable": {
      "comment": "Detail line when a metric could not be read",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No disponible"
          }
        }
      }
    },
    "About Metr": {
      "comment": "Right-click menu item that opens the standard About panel",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerca de Metr"
          }
        }
      }
    },
    "Quit %@": {
      "comment": "Hover button help and VoiceOver label on a Top Apps row: quits that app, e.g. Quit Calculator",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salir de %@"
          }
        }
      }
    },
    "Force Quit %@…": {
      "comment": "Context menu item of an app row: force quits that app, after a confirmation",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Forzar salida de %@…"
          }
        }
      }
    },
    "Force Quit…": {
      "comment": "Borderless button that replaces the numbers of a row whose app did not quit",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Forzar salida…"
          }
        }
      }
    },
    "%@ didn't quit. It may be waiting for you.": {
      "comment": "Tooltip of the Force Quit… offer after Quit was refused or ignored",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no se cerró. Puede que esté esperando una respuesta tuya."
          }
        }
      }
    },
    "Force quit %@?": {
      "comment": "Title of the inline Force Quit confirmation of an app row",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Forzar la salida de %@?"
          }
        }
      }
    },
    "Force quit %@ in %@?": {
      "comment": "Title of the inline Force Quit confirmation of a helper row: helper name, then app name",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Forzar la salida de %1$@ en %2$@?"
          }
        }
      }
    },
    "Unsaved changes will be lost.": {
      "comment": "Body of the Force Quit confirmation of an app",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perderán los cambios sin guardar."
          }
        }
      }
    },
    "The app may stop responding.": {
      "comment": "Body of the Force Quit confirmation of a helper process",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app podría dejar de responder."
          }
        }
      }
    },
    "Cancel": {
      "comment": "Cancel button of the inline Force Quit confirmation",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar"
          }
        }
      }
    },
    "Force Quit": {
      "comment": "Destructive button of the inline Force Quit confirmation",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Forzar salida"
          }
        }
      }
    },
    "Force Quit Process…": {
      "comment": "Context menu item of a helper row: force quits only that process, after a confirmation",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Forzar salida del proceso…"
          }
        }
      }
    },
    "Owned by another user": {
      "comment": "Reason line in the context menu of a row that belongs to another user",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De otro usuario"
          }
        }
      }
    },
    "This is Metr": {
      "comment": "Reason line in the context menu of Metr's own row",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es Metr"
          }
        }
      }
    },
    "Metr can't quit this": {
      "comment": "Reason line in the context menu of a row the system will not let Metr signal",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Metr no puede cerrarlo"
          }
        }
      }
    },
    "Quitting…": {
      "comment": "Shown in a Top Apps row after Quit was sent, until the app exits",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrando…"
          }
        }
      }
    },
    "Quit Metr": {
      "comment": "Panel footer button that quits the app",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salir de Metr"
          }
        }
      }
    },
    "Normal pressure": {
      "comment": "VoiceOver reading for the memory column",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Presión normal"
          }
        }
      }
    },
    "Elevated pressure": {
      "comment": "VoiceOver reading for the memory column",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Presión elevada"
          }
        }
      }
    },
    "Critical pressure": {
      "comment": "VoiceOver reading for the memory column",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Presión crítica"
          }
        }
      }
    },
    "CPU: %@": {
      "comment": "Tooltip line for processor load",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU: %@"
          }
        }
      }
    },
    "Memory: Normal pressure · %@ of %@": {
      "comment": "Tooltip memory line, normal pressure: used of total",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Memoria: presión normal · %1$@ de %2$@"
          }
        }
      }
    },
    "Memory: Elevated pressure · %@ of %@": {
      "comment": "Tooltip memory line, elevated pressure: used of total",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Memoria: presión elevada · %1$@ de %2$@"
          }
        }
      }
    },
    "Memory: Critical pressure · %@ of %@": {
      "comment": "Tooltip memory line, critical pressure: used of total",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Memoria: presión crítica · %1$@ de %2$@"
          }
        }
      }
    },
    " · Swap %@": {
      "comment": "Tooltip suffix appended to the memory line only when swap is in use",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " · Swap %@"
          }
        }
      }
    },
    "Disk: %@ free of %@": {
      "comment": "Tooltip disk line: free amount of total",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Disco: %1$@ libres de %2$@"
          }
        }
      }
    },
    "CPU: unavailable": {
      "comment": "Tooltip line when the CPU read failed",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU: no disponible"
          }
        }
      }
    },
    "Memory: unavailable": {
      "comment": "Tooltip line when the memory read failed",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Memoria: no disponible"
          }
        }
      }
    },
    "Disk: unavailable": {
      "comment": "Tooltip line when the disk read failed",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Disco: no disponible"
          }
        }
      }
    },
    "Metr lives in your menu bar": {
      "comment": "Welcome window headline",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Metr vive en tu barra de menús"
          }
        }
      }
    },
    "Click the rings for details": {
      "comment": "Welcome window instruction under the rings preview",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en los anillos para ver los detalles"
          }
        }
      }
    },
    "Don't see them? Turn Metr on in System Settings › Menu Bar.": {
      "comment": "Welcome window tip about the Menu Bar permission",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿No los ves? Activa Metr en Ajustes del Sistema › Barra de menús."
          }
        }
      }
    },
    "Done": {
      "comment": "Welcome window primary button",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo"
          }
        }
      }
    },
    "Open Menu Bar Settings": {
      "comment": "Welcome window secondary button that opens System Settings",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir ajustes de la Barra de menús"
          }
        }
      }
    },
    "Open System Settings, go to Menu Bar, and turn Metr on.": {
      "comment": "Welcome window tip shown after the Settings deep link could not land on the Menu Bar pane",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Ajustes del Sistema, ve a Barra de menús y activa Metr."
          }
        }
      }
    },
    "User": {
      "comment": "CPU column row label: share of CPU time spent in user processes (PANEL-01)",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuario"
          }
        }
      }
    },
    "System": {
      "comment": "CPU column row label: share of CPU time spent in the kernel and system (PANEL-01)",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistema"
          }
        }
      }
    },
    "User %@, system %@.": {
      "comment": "VoiceOver reading of the CPU column's user and system percentages",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuario %1$@, sistema %2$@."
          }
        }
      }
    },
    "Perf": {
      "comment": "CPU cluster label: abbreviation of the system tier 'Performance' (hw.perflevelN.name)",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rend."
          }
        }
      }
    },
    "Eff": {
      "comment": "CPU cluster label: abbreviation of the system tier 'Efficiency' (hw.perflevelN.name)",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Efic."
          }
        }
      }
    },
    "Super": {
      "comment": "CPU cluster label: the system tier 'Super' (M5 family)",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Super"
          }
        }
      }
    },
    "Performance cores %@": {
      "comment": "VoiceOver: average load of the performance core cluster, e.g. Performance cores 41%",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Núcleos de rendimiento %@"
          }
        }
      }
    },
    "Efficiency cores %@": {
      "comment": "VoiceOver: average load of the efficiency core cluster, e.g. Efficiency cores 18%",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Núcleos de eficiencia %@"
          }
        }
      }
    },
    "Super cores %@": {
      "comment": "VoiceOver: average load of the Super core cluster (M5 family)",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Núcleos Super %@"
          }
        }
      }
    },
    "%@ cores %@": {
      "comment": "VoiceOver: average load of a core cluster with a name this app has no translation for: system name, then percent",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Núcleos %1$@ %2$@"
          }
        }
      }
    },
    "Plenty of memory available.": {
      "comment": "Status line sentence for Normal memory pressure (D-18)",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay memoria de sobra."
          }
        }
      }
    },
    "Memory is getting tight.": {
      "comment": "Status line sentence for Elevated memory pressure (D-18)",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La memoria se está agotando."
          }
        }
      }
    },
    "Memory is very low. Quit apps you don't need.": {
      "comment": "Status line sentence for Critical memory pressure (D-18)",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Queda muy poca memoria. Cierra las apps que no uses."
          }
        }
      }
    },
    "Thermal.Normal": {
      "comment": "Thermal state word after the Thermal label (masculine in Spanish)",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "normal"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Normal"
          }
        }
      }
    },
    "Thermal.Elevated": {
      "comment": "Thermal state word after the Thermal label (masculine in Spanish)",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "elevado"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Elevated"
          }
        }
      }
    },
    "Thermal.Critical": {
      "comment": "Thermal state word after the Thermal label (masculine in Spanish)",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "crítico"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Critical"
          }
        }
      }
    },
    "Thermal state: %@": {
      "comment": "VoiceOver suffix of the status line, e.g. Thermal state: Normal",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estado térmico: %@"
          }
        }
      }
    },
    "%@ · %@": {
      "comment": "Status line: pressure sentence, a middle dot, then the thermal phrase",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@"
          }
        }
      }
    },
    "Thermal %@": {
      "comment": "Thermal phrase: label and state word joined by a no-break space so they never split across lines, e.g. Thermal Normal",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estado térmico %@"
          }
        }
      }
    },
    "Swap %@": {
      "comment": "Memory column line shown only while swap is in use, e.g. Swap 1.2 GB",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Swap %@"
          }
        }
      }
    },
    "%@ used": {
      "comment": "Disk column line under free, e.g. 284 GB used",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ usados"
          }
        }
      }
    },
    "Memory.SwapSpoken": {
      "comment": "VoiceOver suffix of the Memory column, only while swap is in use",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": ", swap %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": ", swap %@"
          }
        }
      }
    },
    "Top Apps": {
      "comment": "Header of the list of the apps using the most CPU or memory",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mayor uso"
          }
        }
      }
    },
    "Sort top apps by": {
      "comment": "Accessibility label of the CPU | Memory segmented control above the app list",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordenar por"
          }
        }
      }
    },
    "App list unavailable.": {
      "comment": "Quiet line shown instead of the app list when the process list cannot be read",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista de apps no disponible."
          }
        }
      }
    },
    "System process": {
      "comment": "VoiceOver suffix on a system row in the Top Apps list, and the reason line of its disabled actions (D-09)",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Proceso del sistema"
          }
        }
      }
    },
    "System processes not shown.": {
      "comment": "Footer line shown while system and other-user processes cannot be read, so the list is not silently incomplete (E5 partial)",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin procesos del sistema."
          }
        }
      }
    },
    "and %lld more…": {
      "comment": "Plain line under an open app group: how many more helper processes are not listed",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "y %lld más…"
          }
        }
      }
    },
    "and %lld more. Opens the Metr window on Processes.": {
      "comment": "VoiceOver label of the 'and N more…' link under an open app group in the panel",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "y %lld más. Abre la ventana de Metr en Procesos."
          }
        }
      }
    },
    "Show all in the Metr window": {
      "comment": "Tooltip of the 'and N more…' link in the panel: it opens the Metr window on that app's processes",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ver todos en la ventana de Metr"
          }
        }
      }
    },
    "Expand %@": {
      "comment": "VoiceOver label of the disclosure chevron of a closed app row, e.g. Expand Google Chrome",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
