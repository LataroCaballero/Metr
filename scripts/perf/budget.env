# Metr's own cost budget (FND-03). Shell-sourceable KEY=VALUE lines only.
# Thresholds come from RESEARCH A11 (bare-app baseline: 0.012% CPU, 0.5 wakeups/s, 15.1 MB).
# Never loosen a threshold without the owner's sign-off recorded in the SUMMARY.
# RE-BASELINED 2026-10-23 with the owner's sign-off (CPU 0.10 -> 0.25, wakeups 1.0 -> 3.0).
# Rationale: the live CPU ring redraws on about 93% of 2 s ticks on a busy Mac, and each redraw costs
# Core Animation / status-item wakeups and main-thread time that the bare-app baseline never pays.
# Measured 300 s idle: 0.18-0.20% CPU, 2.27-2.38 wakeups/s, 15.4 MB. The new limits are still far
# under the 1% ceiling (CEILING_CPU_PCT). Footprint, network and soak limits are unchanged.
CPU_PCT_MAX=0.25
WAKEUPS_PER_SEC_MAX=3.0
FOOTPRINT_MB_MAX=30
FOOTPRINT_SLOPE_MB_PER_HOUR_MAX=0.5
QUICK_SOAK_GROWTH_MB_MAX=2
# ROADMAP ceiling (1% of one core), for reference.
CEILING_CPU_PCT=1.0

# Filled by `scripts/perf/measure.sh 300` (Task 1, Step 5).
MEASURED_CPU_PCT=0.014
MEASURED_WAKEUPS_PER_SEC=0.22
MEASURED_FOOTPRINT_MB=15.0
MEASURED_AT=2026-10-25T17:44:15Z

# SOAK-DECISION 2026-10-25 accept cdhash=c902b131b9aa2e45645faa058ee5cc00397551b9
# MEASURED_SOAK_* below were recorded on CDHash bf7218c5e071dc7ce01d01f1b3d2c40551b7ff7c (01-09); owner waived a re-soak for the 01-10 gap-closure build (disk fresh URL, resume baseline hook); evidence measure.sh 300 BUDGET PASS and soak.sh --quick 60 SOAK OK; Phase 4 re-soaks the shipping build (DIST-05)
# Written by the 24 h Release soak itself when it ends (scripts/perf/soak.sh --release --hours 24).
MEASURED_SOAK_RESULT=OK
MEASURED_SOAK_SLOPE_MB_PER_HOUR=-1.002
MEASURED_SOAK_HOURS=24.00
MEASURED_SOAK_LEAKS_DELTA=0
MEASURED_SOAK_AT=2026-10-24T17:09:03Z
